{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Structura",
  "version": "0.8.3",
  "identifier": "com.structura.app",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:next"
  },
  "app": {
    "windows": [
      {
        "title": "Structura",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server": "server",
      "resources/databases/source.db": "databases/source.db",
      "resources/databases/bdb.db": "databases/bdb.db",
      "resources/databases/strongs-hebrew.db": "databases/strongs-hebrew.db",
      "resources/databases/dodson.db": "databases/dodson.db",
      "resources/databases/abbott-smith.db": "databases/abbott-smith.db",
      "resources/databases/lsj.db": "databases/lsj.db",
      "resources/databases/lxx.db": "databases/lxx.db",
      "resources/databases/ult.db": "databases/ult.db",
      "resources/databases/vcb.db": "databases/vcb.db",
      "resources/user.db.template": "user.db.template"
    },
    "externalBin": [
      "binaries/node"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: DANIEL C OWENS (5QS52T7HF4)",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 480
        },
        "appPosition": {
          "x": 165,
          "y": 400
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 400
        }
      }
    }
  }
}
